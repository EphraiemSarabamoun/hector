{
  "name": "dardania",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --maxWorkers=4",
    "check": "tsc --noEmit",
    "sim": "tsx tools/sim.ts",
    "bench": "tsx tools/bench.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "play": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "play:lan": "npm run build && vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "smoke": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
